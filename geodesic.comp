#version 430 core

uniform double rad_s;

const double EPSILON = 1e-10;
const int MAX_STEPS = 80000;
const double c = 299792458.0; // Speed of light in m/s

const int HEIGHT = 750;
const int WIDTH = 1000;
const int COMPUTE_HEIGHT = 300;
const int COMPUTE_WIDTH = 400;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct Ray {
    double x, y, z;
    double r, phi, theta;
    double dr, dphi, dtheta;
    double E, L, f, dt_dl;
};

Ray initRay(dvec3 position, dvec3 dir, double rad_s) {
    Ray ray;
    ray.x = position.x;
    ray.y = position.y;
    ray.z = position.z;
    
    // Use doubles for the large-scale calculation
    ray.r = sqrt(ray.x * ray.x + ray.y * ray.y + ray.z * ray.z);
    
    // Cast to float for trig functions, then back to double
    ray.phi = double(atan(float(ray.y), float(ray.x)));
    ray.theta = double(acos(float(ray.z / ray.r)));
    
    // Trig functions with float
    float sin_theta = sin(float(ray.theta));
    float cos_theta = cos(float(ray.theta)); 
    float sin_phi = sin(float(ray.phi));
    float cos_phi = cos(float(ray.phi));
    
    // Back to doubles for velocity calculations
    ray.dr = dir.x * double(sin_theta * cos_phi) +
             dir.y * double(sin_theta * sin_phi) +
             dir.z * double(cos_theta);
    
    // Continue with mixed precision...
    ray.dtheta = (dir.x * double(cos_theta * cos_phi) +
                  dir.y * double(cos_theta * sin_phi) -
                  dir.z * double(sin_theta));
    
    ray.dphi = -dir.x * double(sin_phi) + dir.y * double(cos_phi);
    
    ray.L = ray.r * ray.r * double(sin_theta) * ray.dphi;
    ray.f = 1.0 - rad_s / ray.r;
    ray.dt_dl = sqrt((ray.dr * ray.dr) / ray.f + 
                     ray.r * ray.r * (ray.dtheta * ray.dtheta + 
                     double(sin_theta * sin_theta) * ray.dphi * ray.dphi));
    ray.E = ray.f * ray.dt_dl;
    
    return ray;
}

layout(rgba32f, binding = 0) writeonly uniform image2D outputImage;

layout(std430, binding = 1) buffer RayBuffer {
    double rays[];
};

// Simplified geodesic function that just computes derivatives
void geodesic_derivatives(in Ray ray, out double[6] deriv) {
    double r = ray.r;
    double theta = ray.theta;
    double dr = ray.dr;
    double dphi = ray.dphi;
    double dtheta = ray.dtheta;
    
    float sin_theta = sin(float(ray.theta));
    float cos_theta = cos(float(ray.theta));
    
    double f = 1.0 - rad_s / r;
    double E = ray.E;
    double dt_dl = E / f;
    
    // First derivatives (velocities)
    deriv[0] = dr;
    deriv[1] = dphi;
    deriv[2] = dtheta;
    
    // Second derivatives (accelerations)
    // d2r
    deriv[3] = - (rad_s / (2.0 * r * r)) * f * (dt_dl * dt_dl)
               + (rad_s / (2.0 * r * r * f)) * (dr * dr)
               + r * (dtheta * dtheta + double(sin_theta * sin_theta) * dphi * dphi);
    
    // d2phi
    deriv[4] = -2.0 * dr * dphi / r;
               - 2.0 * double((cos_theta / sin_theta)) * dtheta * dphi ;

    // d2theta
    deriv[5] = -2.0 * dr * dtheta / r 
               + double(sin_theta * cos_theta) * dphi * dphi;
}

Ray rk4_step(Ray ray, double dl) {
    // Store initial state
    double y0[6] = { ray.r, ray.phi, ray.theta, ray.dr, ray.dphi, ray.dtheta };
    double k1[6], k2[6], k3[6], k4[6];
    
    // k1 - derivatives at initial point
    geodesic_derivatives(ray, k1);
    
    // k2 - derivatives at midpoint using k1
    Ray ray2 = ray;
    ray2.E = ray.E;
    ray2.r = y0[0] + 0.5 * dl * k1[0];
    ray2.phi = y0[1] + 0.5 * dl * k1[1];
    ray2.theta = y0[2] + 0.5 * dl * k1[2];
    ray2.dr = y0[3] + 0.5 * dl * k1[3];
    ray2.dphi = y0[4] + 0.5 * dl * k1[4];
    ray2.dtheta = y0[5] + 0.5 * dl * k1[5];
    geodesic_derivatives(ray2, k2);
    
    // k3 - derivatives at midpoint using k2
    Ray ray3 = ray;
    ray3.E = ray.E;
    ray3.r = y0[0] + 0.5 * dl * k2[0];
    ray3.phi = y0[1] + 0.5 * dl * k2[1];
    ray3.theta = y0[2] + 0.5 * dl * k2[2];
    ray3.dr = y0[3] + 0.5 * dl * k2[3];
    ray3.dphi = y0[4] + 0.5 * dl * k2[4];
    ray3.dtheta = y0[5] + 0.5 * dl * k2[5];
    geodesic_derivatives(ray3, k3);
    
    // k4 - derivatives at endpoint using k3
    Ray ray4 = ray;
    ray4.E = ray.E;
    ray4.r = y0[0] + dl * k3[0];
    ray4.phi = y0[1] + dl * k3[1];
    ray4.theta = y0[2] + dl * k3[2];
    ray4.dr = y0[3] + dl * k3[3];
    ray4.dphi = y0[4] + dl * k3[4];
    ray4.dtheta = y0[5] + dl * k3[5];
    geodesic_derivatives(ray4, k4);
    
    // Combine with RK4 weights
    ray.r = y0[0] + (dl / 6.0) * (k1[0] + 2.0 * k2[0] + 2.0 * k3[0] + k4[0]);
    ray.phi = y0[1] + (dl / 6.0) * (k1[1] + 2.0 * k2[1] + 2.0 * k3[1] + k4[1]);
    ray.theta = y0[2] + (dl / 6.0) * (k1[2] + 2.0 * k2[2] + 2.0 * k3[2] + k4[2]);
    ray.dr = y0[3] + (dl / 6.0) * (k1[3] + 2.0 * k2[3] + 2.0 * k3[3] + k4[3]);
    ray.dphi = y0[4] + (dl / 6.0) * (k1[4] + 2.0 * k2[4] + 2.0 * k3[4] + k4[4]);
    ray.dtheta = y0[5] + (dl / 6.0) * (k1[5] + 2.0 * k2[5] + 2.0 * k3[5] + k4[5]);

    // Update Cartesian coordinates
    double sin_theta = sin(float(ray.theta));
    double cos_theta = cos(float(ray.theta));
    double sin_phi = sin(float(ray.phi));
    double cos_phi = cos(float(ray.phi));

    ray.x = ray.r * double(sin_theta * cos_phi);
    ray.y = ray.r * double(sin_theta * sin_phi);
    ray.z = ray.r * double(cos_theta);

    return ray;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outputImage);
    if (pixel.x >= imgSize.x || pixel.y >= imgSize.y)
        return;

    float u = (float(pixel.x) / float(imgSize.x)) * 2.0 - 1.0;
    float v = (float(pixel.y) / float(imgSize.y)) * 2.0 - 1.0;
    
    // Move camera much farther away
    double cameraDistance = 1e11;
    vec3 cameraPos = vec3(1e5, 1e5, cameraDistance);
    
    vec3 rayDir;
    float aspectRatio = float(imgSize.x) / float(imgSize.y);
    float tanHalfFov = tan(radians(60.0) / 2.0);
    rayDir.x = u * aspectRatio * tanHalfFov;
    rayDir.y = v * tanHalfFov;
    rayDir.z = -1.0;
    rayDir = normalize(rayDir);
    
    Ray ray = initRay(cameraPos, rayDir, rad_s);
    
    double r0 = ray.r;

    vec4 color = vec4(0.0, 0.0, 0.0, 1.0); // Space
    
    uint steps = 0;
    while (steps < MAX_STEPS){
        if (ray.r <= rad_s * 1.01) {  // Just outside event horizon
            color = vec4(1.0, 0.0, 0.0, 1.0);
            break;
        }
        else if (ray.r > 2 * cameraDistance) { // Far distance
            color = vec4(0.0, 0.0, 0.2, 1.0);
            break;
        }

//        if (ray.r < r0) { // Near distance
//            color = vec4(0.0, 1.0, 0.2, 1.0);
//            break;
//        }
//        else if (ray.r > r0) {
//            color = vec4(0.0, 1.0, 1.0, 1.0);
//            break;
//        }

//        double dt = 10;
//        ray.x += rayDir.x * c * dt;
//        ray.y += rayDir.y * c * dt;
//        ray.z += rayDir.z * c * dt;
//        ray.r = sqrt(ray.x * ray.x + ray.y * ray.y + ray.z * ray.z);

        ray = rk4_step(ray, 1e1);

        steps++;
    }

    uint idx = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * COMPUTE_WIDTH;
    rays[idx] = ray.r;

    imageStore(outputImage, pixel, color);
}
#version 430

// Define the local work group size
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Define your storage buffers or images
layout(std430, binding = 0) buffer RayBuffer {
    float rays[];
};

layout(std430, binding = 1) buffer ScreenBuffer {
    float pixels[];
};

// Optional: uniform variables
uniform double rad_s;

const double EPSILON = 1e-10;

struct Ray {
    double r;
    double phi;
    double theta;
    double dr;
    double dphi;
    double dtheta;
    double E; // Energy of the photon
};

double[6] geodesic(Ray ray, double rad_s, double dl, double y0[6], double temp[6], vec4 trig_funcs) {
    double r = ray.r; double theta = ray.theta;
    double dr = ray.dr; double dphi = ray.dphi; double dtheta = ray.dtheta;
    double E = ray.E;

	double sin_theta = trig_funcs[0]; double cos_theta = trig_funcs[1];
    double sin_phi = trig_funcs[2]; double cos_phi = trig_funcs[3];

    double f = 1.0 - rad_s / r;
    double dt_dl = E / f;

    double d2r = -(rad_s / (2 * r * r)) * f * (dt_dl * dt_dl)
                + (rad_s / (2 * r * r * f)) * (dr * dr)
                + r * (dtheta * dtheta + sin_theta * sin_theta * dphi * dphi);

    double phi_term2;
    if (sin_theta < EPSILON) phi_term2 = 0.0;
    else phi_term2 = -2.0 * (cos_theta / sin_theta) * dtheta * dphi;
    double d2phi = (-2.0 * dr * dphi / r) - phi_term2;
                 
    double d2theta = (-2.0 * dr * dtheta / r) 
                    + sin_theta * cos_theta * dphi * dphi;
    
    temp[0] = y0[0] + dr * dl;
    temp[1] = y0[1] + dphi * dl;
	temp[2] = y0[2] + dtheta * dl;
    temp[3] = y0[3] + d2r * dl;
    temp[4] = y0[4] + d2phi * dl;
	temp[5] = y0[5] + d2theta * dl;

    return double[6] (dr, dphi, dtheta, d2r, d2phi, d2theta);
}

void rk4step(Ray ray, double rad_s, double dl, vec4 trig_funcs) {
    double y0[6] = { ray.r, ray.phi, ray.theta, ray.dr, ray.dphi, ray.dtheta };
    double temp[6];
    double[6] dray1, dray2, dray3, dray4;

    dray1 = geodesic(ray, rad_s, dl / 2.0, y0, temp, trig_funcs);

	Ray r2 = ray; r2.r = temp[0]; r2.phi = temp[1]; r2.theta = temp[2]; 
                  r2.dr = temp[3]; r2.dphi = temp[4]; r2.dtheta = temp[5];
    dray2 = geodesic(r2, rad_s, dl / 2.0, y0, temp, trig_funcs);

    Ray r3 = ray; r3.r = temp[0]; r3.phi = temp[1]; r3.theta = temp[2]; 
                  r3.dr = temp[3]; r3.dphi = temp[4]; r3.dtheta = temp[5];
    dray3 = geodesic(r3, rad_s, dl, y0, temp, trig_funcs);

    Ray r4 = ray; r4.r = temp[0]; r4.phi = temp[1]; r4.theta = temp[2]; 
                  r4.dr = temp[3]; r4.dphi = temp[4]; r4.dtheta = temp[5];
    dray4 = geodesic(r4, rad_s, dl, y0, temp, trig_funcs);

    ray.r      += (dl / 6.0) * (dray1[0] + 2 * dray2[0] + 2 * dray3[0] + dray4[0]);
    ray.phi    += (dl / 6.0) * (dray1[1] + 2 * dray2[1] + 2 * dray3[1] + dray4[1]);
	ray.theta  += (dl / 6.0) * (dray1[2] + 2 * dray2[2] + 2 * dray3[2] + dray4[2]);
    ray.dr     += (dl / 6.0) * (dray1[3] + 2 * dray2[3] + 2 * dray3[3] + dray4[3]);
    ray.dphi   += (dl / 6.0) * (dray1[4] + 2 * dray2[4] + 2 * dray3[4] + dray4[4]);
	ray.dtheta += (dl / 6.0) * (dray1[5] + 2 * dray2[5] + 2 * dray3[5] + dray4[5]);
};

void main() {
    // Get the current invocation's indices
    uvec3 gid = gl_GlobalInvocationID;
    uint idx = gid.x + gid.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    
    rays[idx]
}
#version 430 core

uniform float rad_s;
uniform int COMPUTE_HEIGHT;
uniform int COMPUTE_WIDTH;

const float EPSILON = 1e-10;
const int MAX_STEPS = 100000;
const float c = 299792458.0; // Speed of light in m/s

const int HEIGHT = 750;
const int WIDTH = 1000;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct Ray {
    float x, y, z;
    float r, phi, theta;
    float dr, dphi, dtheta;
    float E, L, f, dt_dl;
};

Ray initRay(vec3 position, vec3 dir) {
    Ray ray;
    ray.x = position.x;
    ray.y = position.y;
    ray.z = position.z;
    
    // Use doubles for the large-scale calculation
    ray.r = length(position);
    
    // Cast to float for trig functions, then back to double
    ray.phi = atan(ray.y, ray.x);
    ray.theta = acos(ray.z / ray.r);
    
    // Trig functions with float
    float sin_theta = sin(ray.theta);
    float cos_theta = cos(ray.theta); 
    float sin_phi = sin(ray.phi);
    float cos_phi = cos(ray.phi);
    
    // Back to doubles for velocity calculations
    ray.dr = dir.x * sin_theta * cos_phi +
             dir.y * sin_theta * sin_phi +
             dir.z * cos_theta;
    
    // Continue with mixed precision...
    ray.dtheta = (dir.x * cos_theta * cos_phi +
                  dir.y * cos_theta * sin_phi -
                  dir.z * sin_theta) / ray.r;
    
    ray.dphi = (-dir.x * sin_phi + dir.y * cos_phi) / (ray.r * sin_theta);
    
    ray.L = ray.r * ray.r * sin_theta * ray.dphi;
    ray.f = 1.0 - rad_s / ray.r;
    ray.dt_dl = sqrt((ray.dr * ray.dr) / ray.f + 
                     ray.r * ray.r * (ray.dtheta * ray.dtheta + 
                     sin_theta * sin_theta * ray.dphi * ray.dphi));
    ray.E = ray.f * ray.dt_dl;

    return ray;
}

layout(rgba32f, binding = 0) writeonly uniform image2D outputImage;

layout(std430, binding = 1) buffer RayBuffer {
    float rays[];
};

layout(std140, binding = 2) uniform CamBuffer {
    vec3 camPos;
    vec3 camFwd;
    vec3 camUp;
    vec3 camRight;
};

// Simplified geodesic function that just computes derivatives
void geodesic_derivatives(in Ray ray, out float[6] deriv) {
    float r = ray.r, theta = ray.theta;
    float dr = ray.dr, dphi = ray.dphi, dtheta = ray.dtheta;
    
    float sin_theta = sin(ray.theta), cos_theta = cos(ray.theta);
    
    float f = 1.0 - rad_s / r;
    float E = ray.E;
    float dt_dl = E / f;
    
    // First derivatives (velocities)
    deriv[0] = dr;
    deriv[1] = dphi;
    deriv[2] = dtheta;
    
    // Second derivatives (accelerations)
    // d2r
    deriv[3] = - (rad_s / (2.0 * r * r)) * f * (dt_dl * dt_dl)
               + (rad_s / (2.0 * r * r * f)) * (dr * dr)
               + r * (dtheta * dtheta + sin_theta * sin_theta * dphi * dphi);
    
    // d2phi
    deriv[4] = -2.0 * dr * dphi / r;
               - 2.0 * (cos_theta / sin_theta) * dtheta * dphi ;

    // d2theta
    deriv[5] = -2.0 * dr * dtheta / r 
               + sin_theta * cos_theta * dphi * dphi;
}

Ray rk4_step(inout Ray ray, float dl) {
    // Store initial state
    float y0[6] = { ray.r, ray.phi, ray.theta, ray.dr, ray.dphi, ray.dtheta };
    float k1[6], k2[6], k3[6], k4[6];
    
    // k1 - derivatives at initial point
    geodesic_derivatives(ray, k1);
    
    // k2 - derivatives at midpoint using k1
    Ray ray2 = ray;
    ray2.r = y0[0] + 0.5 * dl * k1[0];
    ray2.phi = y0[1] + 0.5 * dl * k1[1];
    ray2.theta = y0[2] + 0.5 * dl * k1[2];
    ray2.dr = y0[3] + 0.5 * dl * k1[3];
    ray2.dphi = y0[4] + 0.5 * dl * k1[4];
    ray2.dtheta = y0[5] + 0.5 * dl * k1[5];
    geodesic_derivatives(ray2, k2);
    
    // k3 - derivatives at midpoint using k2
    Ray ray3 = ray;
    ray3.r = y0[0] + 0.5 * dl * k2[0];
    ray3.phi = y0[1] + 0.5 * dl * k2[1];
    ray3.theta = y0[2] + 0.5 * dl * k2[2];
    ray3.dr = y0[3] + 0.5 * dl * k2[3];
    ray3.dphi = y0[4] + 0.5 * dl * k2[4];
    ray3.dtheta = y0[5] + 0.5 * dl * k2[5];
    geodesic_derivatives(ray3, k3);
    
    // k4 - derivatives at endpoint using k3
    Ray ray4 = ray;
    ray4.r = y0[0] + dl * k3[0];
    ray4.phi = y0[1] + dl * k3[1];
    ray4.theta = y0[2] + dl * k3[2];
    ray4.dr = y0[3] + dl * k3[3];
    ray4.dphi = y0[4] + dl * k3[4];
    ray4.dtheta = y0[5] + dl * k3[5];
    geodesic_derivatives(ray4, k4);
    
    // Combine with RK4 weights
    ray.r = y0[0] + (dl / 6.0) * (k1[0] + 2.0 * k2[0] + 2.0 * k3[0] + k4[0]);
    ray.phi = y0[1] + (dl / 6.0) * (k1[1] + 2.0 * k2[1] + 2.0 * k3[1] + k4[1]);
    ray.theta = y0[2] + (dl / 6.0) * (k1[2] + 2.0 * k2[2] + 2.0 * k3[2] + k4[2]);
    ray.dr = y0[3] + (dl / 6.0) * (k1[3] + 2.0 * k2[3] + 2.0 * k3[3] + k4[3]);
    ray.dphi = y0[4] + (dl / 6.0) * (k1[4] + 2.0 * k2[4] + 2.0 * k3[4] + k4[4]);
    ray.dtheta = y0[5] + (dl / 6.0) * (k1[5] + 2.0 * k2[5] + 2.0 * k3[5] + k4[5]);

    // Update Cartesian coordinates
    float sin_theta = sin(ray.theta);
    float cos_theta = cos(ray.theta);
    float sin_phi = sin(ray.phi);
    float cos_phi = cos(ray.phi);

    ray.x = ray.r * sin_theta * cos_phi;
    ray.y = ray.r * sin_theta * sin_phi;
    ray.z = ray.r * cos_theta;

    return ray;
}

Ray euler_step( inout Ray ray, float dl) {
    float deriv[6];
    geodesic_derivatives(ray, deriv);
    
    ray.r += deriv[0] * dl;
    ray.phi += deriv[1] * dl;
    ray.theta += deriv[2] * dl;
    ray.dr += deriv[3] * dl;
    ray.dphi += deriv[4] * dl;
    ray.dtheta += deriv[5] * dl;

    // Update Cartesian coordinates
    float sin_theta = sin(ray.theta);
    float cos_theta = cos(ray.theta);
    float sin_phi = sin(ray.phi);
    float cos_phi = cos(ray.phi);
    ray.x = ray.r * sin_theta * cos_phi;
    ray.y = ray.r * sin_theta * sin_phi;
    ray.z = ray.r * cos_theta;

    return ray;
}

bool check_planet(Ray ray, vec3 planetPos, float planetRadius) {
    vec3 rayPos = vec3(ray.x, ray.y, ray.z);
    float dist = length(rayPos - planetPos);
    return dist <= planetRadius;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outputImage);
    if (pixel.x >= imgSize.x || pixel.y >= imgSize.y)
        return;

    float u = (2.0 * (pixel.x + 0.5) / COMPUTE_WIDTH - 1.0);
    float v = (1.0 - 2.0 * (pixel.y + 0.5) / COMPUTE_HEIGHT);

    vec3 planet_pos = vec3(-1.5e5, 0, 0); // 1 AU in meters
    float planet_rad = 5e3; // 10x Earth's radius in meters
    
    vec3 rayDir;
    float aspectRatio = float(imgSize.x) / float(imgSize.y);
    float tanHalfFov = tan(radians(60.0) / 2.0);

    rayDir = normalize(camRight * (u * aspectRatio * tanHalfFov) + camUp * (v * tanHalfFov) + camFwd);
    
    Ray ray = initRay(camPos, rayDir);

    vec4 color = vec4(0.0, 0.0, 0.0, 1.0); // Space
    
    uint steps = 0;
    while (steps < MAX_STEPS){

        if (ray.r <= rad_s) {  // Just outside event horizon
            color = vec4(0.0, 0.0, 1.0, 1.0);
            break;
        }
//        else if (check_planet(ray, planet_pos, planet_rad)) { // Planet at 1 AU with 10x Earth's radius
//            color = vec4(1.0, 0.0, 0.0, 1.0); // Planet color
//            break;
//        }        
        else if (ray.r > 1e30) { // Far distance
//            color = vec4(0.0, 0.0, 0.1, 1.0);
            break;
        }

        ray = euler_step(ray, ray.r*0.01);

        steps++;
    }

    uint idx = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * COMPUTE_WIDTH;
    rays[idx] = ray.r;

    imageStore(outputImage, pixel, color);
}